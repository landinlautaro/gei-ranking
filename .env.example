# Copiar a .env (no se versiona). El backend lee estas variables de entorno.

# Local (docker-compose). Para Neon: Host=<endpoint>.neon.tech;...;SSL Mode=Require
ConnectionStrings__Default=Host=localhost;Port=5433;Database=gei_ranking;Username=gei;Password=gei_dev_password

# Orígenes permitidos por CORS, separados por coma
Cors__AllowedOrigins=http://localhost:5173

# Secreto para firmar los JWT: OBLIGATORIO en producción (32+ caracteres, aleatorio, nunca el de ejemplo).
# En desarrollo, si falta, la API genera uno al azar en cada arranque (los tokens dejan de valer al reiniciar).
# Generar uno:  openssl rand -base64 48
Jwt__Secret=
# Opcionales: Jwt__Issuer, Jwt__Audience, Jwt__ExpiresMinutes (por defecto 480 = 8 horas)

# Primer administrador. Solo los lee el comando:  dotnet run --project backend/src/GeiRanking.Api -- seed-admin
# La contraseña debe tener al menos 10 caracteres. Si el usuario ya existe, no se modifica.
Admin__Username=
Admin__Password=

# Carpeta donde se guardan las fotos de los jugadores (por defecto backend/src/GeiRanking.Api/uploads/photos)
# Storage__PhotosPath=

# Intentos de login permitidos por minuto y por dirección IP (por defecto 10)
# RateLimit__LoginPermitPerMinute=10

# --- Solo para el sitio (build del frontend) ---
# Dirección de la API cuando el sitio se publica en otro lugar que la API (p. ej. Cloudflare Pages + Fly.io).
# Vacío = mismo origen (desarrollo con el proxy de Vite, o la imagen nginx).
# VITE_API_BASE_URL=https://gei-ranking-api.fly.dev

# --- Backups (ops/backup/backup.sh y backup.ps1) ---
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# BACKUP_DIR=./backups
# KEEP_DAYS=30
